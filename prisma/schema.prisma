// TÜRKTECH 50 — Project Tracking MVP data model
// Principle: the system records & makes visible; it never makes selection/jury decisions automatically.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN // program coordinator
  TEAM // student team member
  MENTOR
  JURY
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  WAITLIST
  REJECTED
}

enum ProjectStage {
  VALIDATION
  PROTOTYPE
  MVP
  QA // quality assurance / midterm jury
  SUBMITTED // competition application sent
}

enum ProjectHealth {
  ON_TRACK
  WATCH
  AT_RISK
}

enum CompetitionResult {
  PENDING
  FINALIST
  NOT_SELECTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  BLOCKED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum SessionStatus {
  PLANNED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ChecklistCategory {
  CORE
  ANNEX
  CONDITIONAL
}

enum ChecklistStatus {
  MISSING
  UPLOADED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum RiskStatus {
  OPEN
  MITIGATING
  CLOSED
}

enum RubricKind {
  SELECTION // application pre-evaluation
  MIDTERM // ara jüri
  FINAL // deneme finali
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
}

// ---------- Academy (ADNSU TEKNOFEST 2027 Academy, merged) ----------

enum RuleStatus {
  TRACKING // 2027 rules being watched
  CHANGED // official rules changed since last check
  CONFIRMED // confirmed against the official HTTPS source (source URL mandatory)
}

enum RegistryStatus {
  PLANNED
  ACTIVE
  ARCHIVED
}

enum LabStatus {
  AVAILABLE
  LIMITED
  CLOSED
}

enum PartnerStatus {
  CANDIDATE
  NEGOTIATING
  ACTIVE
  ARCHIVED
}

enum StudentStatus {
  CANDIDATE
  SEEKING_TEAM
  IN_TEAM
  ARCHIVED
}

enum TeamStatus {
  FORMING
  ACTIVE
  ARCHIVED
}

enum TrainingStatus {
  PLANNED
  REGISTRATION_OPEN
  COMPLETED
}

enum ResourceStatus {
  NEW
  UNDER_REVIEW
  APPROVED
  REJECTED
  DONE
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
}

enum IntakeStatus {
  SUBMITTED // sent by students through the public /apply form
  UNDER_REVIEW // a coordinator took it into review
  NEEDS_CHANGES // returned to the students with a note (they edit via their tracking link)
  ACCEPTED // became an ACTIVE Academy team
  REJECTED
  WITHDRAWN // withdrawn by the students before a decision
}

// Configurable process (workflow) stages. System stages (systemKey != null) are bound to existing enum values
// (ApplicationStatus / ProjectStage / CompetitionResult / FINAL rubric) and are moved automatically;
// custom stages (systemKey = null) are reached only by a manual move (ADMIN/root, with a note).
enum WorkflowScope {
  APPLICATION
  PROJECT
}

enum WorkflowStageKind {
  NORMAL // main line
  DECISION // positive outcome of a human decision point
  WAITING // waitlist / on hold (side path)
  REJECTED // rejected / not selected (side path)
  DONE // terminal success
}

model University {
  id             String          @id @default(cuid())
  name           String
  shortName      String
  country        String // ISO-2: AZ, TR, KZ, UZ, KG, TM
  city           String
  isPartner      Boolean         @default(false) // false = pilot host / confirmed; true = invited partner
  users          User[]
  projects       Project[]
  applications   Application[]
  faculties      Faculty[]
  labs           Lab[]
  students       Student[]
  teams          Team[]
  intakeRequests IntakeRequest[]
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  name               String
  passwordHash       String
  role               Role
  isRoot             Boolean              @default(false) // system owner: protected, only root manages ADMIN accounts
  mustChangePassword Boolean              @default(false) // generated temporary password: must be changed at next sign-in
  passwordChangedAt  DateTime? // sessions issued before this instant are rejected (password change / reset signs out other sessions)
  title              String? // e.g. "Proqram koordinatoru", "Professor", "Software engineer"
  expertise          String? // mentors/jury: comma separated tags
  locale             String               @default("az")
  active             Boolean              @default(true)
  universityId       String?
  university         University?          @relation(fields: [universityId], references: [id])
  facultyId          String? // mentors / staff: home faculty (Academy registry)
  faculty            Faculty?             @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  createdAt          DateTime             @default(now())
  lastLoginAt        DateTime?
  memberships        ProjectMember[]
  mentorAssignments  MentorAssignment[]
  juryAssignments    JuryAssignment[]
  assignedTasks      Task[]               @relation("TaskAssignee")
  createdTasks       Task[]               @relation("TaskCreator")
  mentorSessions     MentorSession[]
  ownedRisks         Risk[]
  documents          Document[]
  evaluations        Evaluation[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  reviewedChecklists ChecklistItem[]      @relation("ChecklistReviewer")
  ruleOwnerships     Competition[]        @relation("RuleOwner")
  mentoredTeams      Team[]               @relation("TeamMentor")
  trainings          Training[]           @relation("TrainingMentor")
  resourceRequests   ResourceRequest[]    @relation("ResourceRequester")
  resourceDecisions  ResourceRequest[]    @relation("ResourceDecider")
  announcements      Announcement[]
  studentProfile     Student?
  intakeReviews      IntakeRequest[]      @relation("IntakeReviewer")
  intakeEvents       IntakeEvent[]
  workflowMoves      WorkflowTransition[]
}

model Competition {
  id                  String          @id @default(cuid())
  name                String // e.g. "Sağlıkta Yapay Zeka Yarışması"
  organizer           String
  category            String? // lib/constants CATEGORIES key; null for catalog cards (they carry `theme`)
  country             String
  applicationDeadline DateTime? // official deadline — unknown (null) until the 2027 rules are published
  finalDate           DateTime?
  url                 String?
  // TEKNOFEST catalog card (2026 archive) — null for non-catalog competitions
  catalogId           Int?            @unique
  theme               String? // lib/constants COMPETITION_THEMES key
  subcategories       String[]
  // 2027 rule tracking (null ruleStatus = not tracked)
  ruleStatus          RuleStatus?
  ruleOwnerId         String?
  ruleOwner           User?           @relation("RuleOwner", fields: [ruleOwnerId], references: [id], onDelete: SetNull)
  ruleSourceUrl       String? // official 2027 şartname link (HTTPS), mandatory for CONFIRMED
  ruleCheckedAt       DateTime?
  ruleNotes           String?
  projects            Project[]
  applications        Application[]
  teams               Team[]
  intakeRequests      IntakeRequest[]
}

model Application {
  id              String               @id @default(cuid())
  code            String               @unique // APP-0001
  teamName        String
  projectTitle    String
  problem         String
  solution        String
  category        String // see lib/constants CATEGORIES
  memberCount     Int
  contactName     String
  contactEmail    String
  universityId    String
  university      University           @relation(fields: [universityId], references: [id])
  competitionId   String?
  competition     Competition?         @relation(fields: [competitionId], references: [id])
  status          ApplicationStatus    @default(SUBMITTED)
  decisionNote    String? // human decision rationale (admin)
  decidedAt       DateTime?
  submittedAt     DateTime             @default(now())
  projectId       String?              @unique
  project         Project?             @relation(fields: [projectId], references: [id])
  evaluations     Evaluation[]
  teamId          String? // Academy team this application was created from (a rejected team may apply again)
  team            Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  workflowStageId String?
  workflowStage   WorkflowStage?       @relation(fields: [workflowStageId], references: [id], onDelete: SetNull)
  workflowHistory WorkflowTransition[]

  @@index([workflowStageId])
}

model Project {
  id                String               @id @default(cuid())
  code              String               @unique // T50-001
  title             String
  tagline           String
  summary           String
  category          String
  universityId      String
  university        University           @relation(fields: [universityId], references: [id])
  competitionId     String?
  competition       Competition?         @relation(fields: [competitionId], references: [id])
  facultyId         String?
  faculty           Faculty?             @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  labId             String?
  lab               Lab?                 @relation(fields: [labId], references: [id], onDelete: SetNull)
  partnerId         String?
  partner           Partner?             @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  stage             ProjectStage         @default(VALIDATION)
  health            ProjectHealth        @default(ON_TRACK)
  prototypeVerified Boolean              @default(false) // KPI: functional prototype/MVP with test evidence
  packageQcPassed   Boolean              @default(false) // KPI: application package passed QC checklist
  submittedAt       DateTime? // competition application sent
  result            CompetitionResult    @default(PENDING)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  application       Application?
  members           ProjectMember[]
  mentors           MentorAssignment[]
  jurors            JuryAssignment[]
  tasks             Task[]
  sessions          MentorSession[]
  checklist         ChecklistItem[]
  documents         Document[]
  risks             Risk[]
  evaluations       Evaluation[]
  auditLogs         AuditLog[]
  stageHistory      StageChange[]
  resourceRequests  ResourceRequest[]
  workflowStageId   String?
  workflowStage     WorkflowStage?       @relation(fields: [workflowStageId], references: [id], onDelete: SetNull)
  workflowHistory   WorkflowTransition[]

  @@index([workflowStageId])
}

model StageChange {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStage ProjectStage
  toStage   ProjectStage
  note      String?
  actorId   String?
  createdAt DateTime     @default(now())
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamRole  String // free text: "Team lead", "Hardware", "Software", "Business"
  isLead    Boolean @default(false)

  @@unique([projectId, userId])
  @@index([userId])
}

model MentorAssignment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mentorId  String
  mentor    User     @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  focus     String? // e.g. "Technical", "Business", "IP"
  createdAt DateTime @default(now())

  @@unique([projectId, mentorId])
  @@index([mentorId])
}

model JuryAssignment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  juryId    String
  jury      User     @relation(fields: [juryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, juryId])
  @@index([juryId])
}

model Task {
  id                 String         @id @default(cuid())
  projectId          String
  project            Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  acceptanceCriteria String? // "Meyar" — definition of done
  assigneeId         String?
  assignee           User?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById        String?
  createdBy          User?          @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  dueDate            DateTime
  priority           Priority       @default(MEDIUM)
  status             TaskStatus     @default(TODO)
  evidenceUrl        String? // link to demo/test evidence
  sourceSessionId    String? // created from a mentor session's next step
  sourceSession      MentorSession? @relation(fields: [sourceSessionId], references: [id], onDelete: SetNull)
  week               Int? // program week 1..8
  completedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([projectId, status, dueDate])
  @@index([assigneeId, status])
}

model MentorSession {
  id          String        @id @default(cuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mentorId    String
  mentor      User          @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  durationMin Int           @default(45)
  topic       String
  agenda      String? // team prepares before meeting
  notes       String? // mentor writes after meeting
  nextSteps   String[] // each line can be converted into a Task
  status      SessionStatus @default(PLANNED)
  online      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  tasks       Task[]

  @@index([projectId, scheduledAt])
  @@index([mentorId, scheduledAt])
}

model ChecklistItem {
  id           String            @id @default(cuid())
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key          String? // template key -> translated label "documents.items.<key>.title"; null for custom items
  title        String? // custom item title (when key is null)
  category     ChecklistCategory @default(CORE)
  required     Boolean           @default(true)
  status       ChecklistStatus   @default(MISSING)
  reviewerNote String?
  reviewerId   String?
  reviewer     User?             @relation("ChecklistReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  order        Int               @default(0)
  documents    Document[]
  updatedAt    DateTime          @updatedAt

  @@index([projectId])
}

model Document {
  id              String         @id @default(cuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checklistItemId String?
  checklistItem   ChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  fileName        String
  storedName      String // file on disk under UPLOAD_DIR
  mimeType        String
  size            Int
  version         Int            @default(1)
  confidential    Boolean        @default(false) // trade secret / patentable — never in public pitch material
  uploadedById    String?
  uploadedBy      User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  @@index([projectId, checklistItemId])
}

model Risk {
  id          String     @id @default(cuid())
  projectId   String? // null = program-level risk
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  probability RiskLevel  @default(MEDIUM)
  impact      RiskLevel  @default(MEDIUM)
  mitigation  String?
  ownerId     String?
  owner       User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  status      RiskStatus @default(OPEN)
  reviewDate  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([projectId, status])
}

model Rubric {
  id          String            @id @default(cuid())
  kind        RubricKind        @unique
  criteria    RubricCriterion[]
  evaluations Evaluation[]
}

model RubricCriterion {
  id       String            @id @default(cuid())
  rubricId String
  rubric   Rubric            @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  key      String // translated label "jury.criteria.<key>.title" / ".hint"
  weight   Int // percentage, criteria of a rubric sum to 100
  maxScore Int               @default(5)
  order    Int               @default(0)
  scores   EvaluationScore[]
}

model Evaluation {
  id             String            @id @default(cuid())
  rubricId       String
  rubric         Rubric            @relation(fields: [rubricId], references: [id])
  evaluatorId    String
  evaluator      User              @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  applicationId  String? // SELECTION rubric
  application    Application?      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  projectId      String? // MIDTERM / FINAL rubric
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comment        String?
  recommendation String? // free text "next step" — advisory only, not a decision
  status         EvaluationStatus  @default(DRAFT)
  submittedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  scores         EvaluationScore[]

  @@unique([rubricId, evaluatorId, applicationId])
  @@unique([rubricId, evaluatorId, projectId])
}

model EvaluationScore {
  id           String          @id @default(cuid())
  evaluationId String
  evaluation   Evaluation      @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterionId  String
  criterion    RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  score        Int

  @@unique([evaluationId, criterionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String // e.g. "task.create", "project.stage", "evaluation.submit" -> translated "audit.actions.<action>"
  entity    String // "Task", "Project", ...
  entityId  String
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull) // keep the trail when a project is deleted
  summary   String? // short human readable detail (e.g. task title)
  meta      Json?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // translated "common.notifications.<type>" with params
  params    Json?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ---------- Academy models (merged from the ADNSU TEKNOFEST 2027 Academy panel) ----------

model Faculty {
  id             String          @id @default(cuid())
  universityId   String
  university     University      @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name           String
  coordinator    String? // faculty coordinator name / contact (no login in MVP)
  status         RegistryStatus  @default(ACTIVE)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  labs           Lab[]
  students       Student[]
  teams          Team[]
  projects       Project[]
  users          User[]
  intakeRequests IntakeRequest[]
  intakeMembers  IntakeMember[]

  @@unique([universityId, name])
}

model Lab {
  id               String            @id @default(cuid())
  universityId     String
  university       University        @relation(fields: [universityId], references: [id], onDelete: Cascade)
  facultyId        String?
  faculty          Faculty?          @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  name             String
  contact          String?
  status           LabStatus         @default(AVAILABLE)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  projects         Project[]
  trainings        Training[]
  resourceRequests ResourceRequest[]
}

model Partner {
  id               String            @id @default(cuid())
  name             String
  sector           String?
  contact          String?
  status           PartnerStatus     @default(CANDIDATE)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  projects         Project[]
  resourceRequests ResourceRequest[]
}

/// Student registry (no login). One student belongs to at most one team (single FK).
model Student {
  id           String        @id @default(cuid())
  universityId String
  university   University    @relation(fields: [universityId], references: [id], onDelete: Cascade)
  facultyId    String?
  faculty      Faculty?      @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  name         String
  email        String        @unique // stored lower-case
  status       StudentStatus @default(SEEKING_TEAM)
  skills       String? // free text: "Embedded, CAD"
  notes        String?
  teamId       String?
  team         Team?         @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  captainOf    Team?         @relation("TeamCaptain")
  userId       String?       @unique // linked TEAM account once the team's project workspace exists
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([teamId])
}

/// Academy team formed before applying. Becomes an Application (then a Project) through the normal selection flow.
model Team {
  id            String         @id @default(cuid())
  universityId  String
  university    University     @relation(fields: [universityId], references: [id], onDelete: Cascade)
  facultyId     String?
  faculty       Faculty?       @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  name          String
  status        TeamStatus     @default(FORMING)
  mentorId      String?
  mentor        User?          @relation("TeamMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  competitionId String?
  competition   Competition?   @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  captainId     String?        @unique
  captain       Student?       @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: SetNull)
  members       Student[]      @relation("TeamMembers")
  applications  Application[]
  intakeRequest IntakeRequest? // public preparation request this team was accepted from
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Training {
  id          String         @id @default(cuid())
  title       String
  startsAt    DateTime
  durationMin Int            @default(90)
  status      TrainingStatus @default(PLANNED)
  mentorId    String?
  mentor      User?          @relation("TrainingMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  labId       String?
  lab         Lab?           @relation(fields: [labId], references: [id], onDelete: SetNull)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([startsAt])
}

/// Material / equipment / lab-time request of a project. Approval is a human decision with a mandatory note.
model ResourceRequest {
  id            String         @id @default(cuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  details       String?
  labId         String?
  lab           Lab?           @relation(fields: [labId], references: [id], onDelete: SetNull)
  partnerId     String?
  partner       Partner?       @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  neededBy      DateTime?
  status        ResourceStatus @default(NEW)
  requestedById String?
  requestedBy   User?          @relation("ResourceRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedById   String?
  decidedBy     User?          @relation("ResourceDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decisionNote  String?
  decidedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([projectId, status])
}

model Announcement {
  id          String             @id @default(cuid())
  title       String
  body        String
  status      AnnouncementStatus @default(DRAFT)
  audience    Role[] // roles that see it (at least one)
  authorId    String?
  author      User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status, publishedAt])
}

// ---------- Public "preparation request" intake (students apply to the Academy without an account) ----------

/// Submitted through the public /apply form. Nothing is written to the Student/Team registry until a coordinator accepts it.
model IntakeRequest {
  id            String         @id @default(cuid())
  code          String         @unique // HZ-0001
  tokenHash     String         @unique // sha256 (hex) of the secret tracking token; the raw token is only in the student's link
  status        IntakeStatus   @default(SUBMITTED)
  teamName      String
  universityId  String
  university    University     @relation(fields: [universityId], references: [id])
  facultyId     String?
  faculty       Faculty?       @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  competitionId String // TEKNOFEST catalog card
  competition   Competition    @relation(fields: [competitionId], references: [id])
  subcategory   String? // one of competition.subcategories
  projectIdea   String
  needs         String[] // INTAKE_NEEDS keys (src/components/intake/shared.ts)
  needsNote     String?
  consentAt     DateTime
  reviewerId    String?
  reviewer      User?          @relation("IntakeReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote    String? // latest coordinator note (full history in IntakeEvent)
  reviewedAt    DateTime?
  teamId        String?        @unique
  team          Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  submittedAt   DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  members       IntakeMember[]
  events        IntakeEvent[]

  @@index([status, submittedAt])
}

model IntakeMember {
  id        String        @id @default(cuid())
  requestId String
  request   IntakeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  name      String
  email     String // lower-case
  facultyId String?
  faculty   Faculty?      @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  role      String?
  isCaptain Boolean       @default(false)
  order     Int           @default(0)

  @@index([email])
}

/// Status history of an intake request (shown to the students on their tracking page and to coordinators).
model IntakeEvent {
  id        String        @id @default(cuid())
  requestId String
  request   IntakeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  from      IntakeStatus?
  to        IntakeStatus
  note      String?
  actorId   String?
  actor     User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  source    String // "public" | "admin"
  at        DateTime      @default(now())

  @@index([requestId, at])
}

/// Database-backed rate limiting (login attempts, public intake). Old rows are pruned on write.
model RateEvent {
  id        String   @id @default(cuid())
  bucket    String // "login" | "intake" | "intake-lookup" | "intake-global"
  key       String // e.g. lower-case e-mail + IP, or "*" for a global bucket
  createdAt DateTime @default(now())

  @@index([bucket, key, createdAt])
  @@index([createdAt])
}

model WorkflowStage {
  id               String               @id @default(cuid())
  scope            WorkflowScope
  systemKey        String?              @unique // e.g. "APP_SUBMITTED", "VALIDATION", "MOCK_FINAL", "RESULT_FINALIST"; null = custom
  nameAz           String
  nameTr           String
  nameEn           String
  descriptionAz    String?
  descriptionTr    String?
  descriptionEn    String?
  order            Int // position inside its scope (applications first, then projects)
  kind             WorkflowStageKind    @default(NORMAL)
  responsibleRoles Role[] // first = primary lane in the process diagram
  active           Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  projects         Project[]
  applications     Application[]
  transitionsFrom  WorkflowTransition[] @relation("WorkflowFrom")
  transitionsTo    WorkflowTransition[] @relation("WorkflowTo")

  @@index([scope, order])
}

/// History of workflow moves (automatic = triggered by an existing flow, manual = ADMIN/root with a note).
model WorkflowTransition {
  id            String         @id @default(cuid())
  scope         WorkflowScope
  projectId     String?
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application?   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStageId   String?
  fromStage     WorkflowStage? @relation("WorkflowFrom", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStageId     String?
  toStage       WorkflowStage? @relation("WorkflowTo", fields: [toStageId], references: [id], onDelete: SetNull)
  actorId       String?
  actor         User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  auto          Boolean        @default(false)
  note          String?
  createdAt     DateTime       @default(now())

  @@index([projectId, createdAt])
  @@index([applicationId, createdAt])
}
